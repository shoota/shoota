{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "constraints": {
    "npm": "<12"
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchDepTypes": [
        "dependencies"
      ],
      "groupName": "dependencies"
    },
    {
      "matchDepTypes": [
        "devDependencies"
      ],
      "groupName": "devDependencies"
    },
    {
      "description": "npm 12 は npm/cli#9800 で lock 更新に失敗するため、constraints.npm の引き上げを止める",
      "matchManagers": [
        "renovate-config"
      ],
      "matchDepNames": [
        "npm"
      ],
      "enabled": false
    }
  ]
}
